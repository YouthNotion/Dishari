# Environment variables read by config/settings/. Copy to .env (never commit it).
# Django does not read .env by itself. Load it into your shell before running:
#
#     set -a; source .env; set +a
#     python manage.py runserver
#
# For local development nothing here is required; the defaults just work.

# Which settings module to use: config.settings.dev (local) | config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

# ---------------------------------------------------------------------------
# Production only (in production, set these in your host or Vercel dashboard)
# ---------------------------------------------------------------------------

# Required in production; the site refuses to start without it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# DJANGO_SECRET_KEY=

# Comma-separated. On Vercel the *.vercel.app hosts are added automatically.
# (In dev, localhost is always allowed and these only add extra hosts.)
# DJANGO_ALLOWED_HOSTS=example.org,www.example.org
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.org,https://www.example.org

# Canonical address used in link previews and the canonical link (no trailing slash).
# DJANGO_SITE_URL=https://example.org

# Security toggles
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=3600
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# DJANGO_SECURE_HSTS_PRELOAD=false
# DJANGO_BEHIND_TLS_PROXY=true

# Logging (stdout)
# DJANGO_LOG_LEVEL=INFO
