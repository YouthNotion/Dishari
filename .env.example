# Copy to .env (never commit .env) and export before running, or configure in your host.

# Which settings module to use: config.settings.dev | config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

# Required in production. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me

# Comma-separated. *.vercel.app hosts are added automatically on Vercel.
DJANGO_ALLOWED_HOSTS=example.org,www.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.org,https://www.example.org

# Production security toggles
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=3600
# DJANGO_BEHIND_TLS_PROXY=true
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# DJANGO_SECURE_HSTS_PRELOAD=false

# Logging (stdout)
# DJANGO_LOG_LEVEL=INFO
